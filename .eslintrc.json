{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "env": {
    "node": true,
    "es2022": true
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "ignorePatterns": ["dist/", "node_modules/", "src/public/", "src/utils/deprecated/"],
  "rules": {
    "no-console": "warn",
    "prefer-const": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_|^(req|res|next|val)$", "varsIgnorePattern": "^_", "caughtErrors": "none" }
    ],
    "@typescript-eslint/no-explicit-any": "warn",
    // Mongoose's own generics use `{}` for empty query helpers / methods, and
    // empty interfaces are used for declaration merging. (Replaces the v7
    // `ban-types` `{}` exemption and `no-empty-interface: off`.)
    "@typescript-eslint/no-empty-object-type": "off"
  },
  "overrides": [
    {
      // One-off CLI maintenance scripts print progress to stdout.
      "files": ["src/scripts/**/*.ts"],
      "rules": { "no-console": "off" }
    }
  ]
}
