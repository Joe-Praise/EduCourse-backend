NODE_ENV=development
PORT=3050

# Cloudinary — image uploads (set before hitting /updateMe or /uploadResources routes)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# MongoDB Atlas
DATABASE=mongodb+srv://<user>:<PASSWORD>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
DATABASE_PASSWORD=<your-database-password>
MONGODB_ATLAS_PUBLIC_KEY=<atlas-public-key>
MONGODB_ATLAS_PRIVATE_KEY=<atlas-private-key>
MONGODB_ATLAS_CLUSTER=Cluster0
MONGODB_ATLAS_PROJECT_ID=<atlas-project-id>

# JWT — generate a long random string for production
JWT_SECRET=<256-bit-random-secret>
# Access-token TTL. Keep short — the refresh-token flow rotates these
# automatically. 15m is a good default; rotation handles the rest.
JWT_EXPIRES_IN=15m
# Legacy access-cookie TTL (days). Now overridden by JWT_EXPIRES_IN for the
# JWT itself; kept here only for older code that hasn't migrated yet.
JWT_COOKIE_EXPIRES_IN=1
# Refresh-token TTL in DAYS. Each successful /refresh rotates the token, so
# the effective session length is N days OF INACTIVITY (not from login).
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD= # leave empty if not using password
REDIS_TLS=false

# Agentic AI subsystem — populate when an external agent service is available.
# Leave empty in dev; the system will no-op via safeTriggerAgent.
AGENT_SERVICE_URL=
AGENT_SERVICE_SECRET=
AGENT_API_KEY=
AGENT_PROJECT_ID=

# Email (Resend) — required for forgot-password flow
RESEND_API_KEY=<resend-api-key>
RESEND_TO_EMAIL=<your-inbox-for-dev-testing>
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:5173

# Session secret for express-session — generate a long random string
SESSION_SECRET=<256-bit-random-secret>

# Sentry error tracking — leave empty to disable (dev default)
SENTRY_DSN=
