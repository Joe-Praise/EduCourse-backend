{
  "name": "building-safety-project",
  "version": "1.0.0",
  "description": "This project shows building experts and starters good on site practices to adhere to while on site",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
    "start": "NODE_ENV=production node dist/server.js",
    "debug": "ndb src/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --max-warnings 166",
    "clean": "powershell -Command \"Get-ChildItem -Path . -Include *.js,*.d.ts,*.js.map,*.d.ts.map -Recurse | Where-Object { $_.FullName -notmatch 'node_modules|public' } | Remove-Item -Force\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Joe Praise",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^10.56.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemon": "^3.1.14",
    "rate-limit-redis": "^4.2.2",
    "redis": "^5.8.2",
    "resend": "^6.32.1",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "validator": "^13.15.35",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.5.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "22.x"
  }
}
